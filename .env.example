# Supabase — Project Settings → API
# https://supabase.com/dashboard/project/_/settings/api
#
# Copy to `.env` or `.env.local` (Vite loads both; `.env.local` overrides).

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Prefer the default publishable key (matches Supabase dashboard naming)
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=sb_publishable_your_key_here
# Optional fallback: legacy anon JWT if you do not set publishable
# VITE_SUPABASE_ANON_KEY=eyJ...

# Better Stack — https://betterstack.com → Logs → your source → "Source token"
# VITE_BETTERSTACK_DSN=your_source_token_here

# Matlu Codex URL — used for the in-game playtest feedback link
# VITE_WIKI_URL=https://matlu-codex.vercel.app

# PixelLab — https://www.pixellab.ai (Account → API)
# Used by scripts/sync-pixellab.mjs and the agent workflows (sprite-credit-burn,
# npc-sprite-gen, weekly stats). Not a Vite var — only consumed by Node scripts
# and GitHub Actions, so it does not need the VITE_ prefix.
# PIXELLAB_API_KEY=your_pixellab_key_here
