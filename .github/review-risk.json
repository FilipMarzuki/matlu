{
  "$comment": "Risk rules for PR review routing (#1431). Each rule adds its weight once if any changed file matches. The total picks the tier; a high tier runs the lenses of the rules that matched. Tune the weights here, not in code.",
  "tiers": { "medium": 3, "high": 6 },
  "rules": [
    { "id": "determinism", "label": "seeded randomness / golden hashes", "weight": 6, "lens": "determinism",
      "paths": ["src/artificer/rng.ts", "storytelling/**", "mapgen/**", "worldmap/**"] },
    { "id": "sim-core", "label": "Artificer sim core", "weight": 3, "lens": "determinism",
      "paths": ["src/artificer/*.ts"], "exclude": ["**/*.test.ts"] },
    { "id": "saves", "label": "save format", "weight": 4, "lens": "saves",
      "$comment": "paths: files wholly about saves, where any edit counts. content (#1781): files that only partly are, which count only when an added or removed line touches a pattern. `line` is a regex on the changed line, `within` on the top-level declaration it sits in; the capture groups name the match in the reason.",
      "paths": ["src/artificer/legacy.ts", "src/lib/*save*.ts", "src/lib/*Save*.ts"],
      "content": {
        "paths": ["src/artificer-app/controller.ts", "src/artificer/*.ts"],
        "exclude": ["**/*.test.ts"],
        "patterns": [
          { "$comment": "the save's version and storage keys", "line": "\\b(SAVE_VERSION|SAVE_KEY|HISTORY_KEY)\\b" },
          { "$comment": "inside the save and history (de)serializers", "within": "^export (?:async )?function ((?:de)?serialize(?:History)?)\\b" },
          { "$comment": "a save validator, defined, called or imported", "line": "\\b(valid[A-Z][\\w$]*)\\b" },
          { "$comment": "inside a save validator", "within": "^(?:export )?(?:function|const) (valid[A-Z][\\w$]*)\\b" },
          { "$comment": "a field added, removed or retyped in the saved state", "within": "^export interface (Region1State|AppState)\\b", "line": "^\\s*(?:readonly\\s+)?([A-Za-z_$][\\w$]*)\\??\\s*:" }
        ]
      } },
    { "id": "workflows", "label": "CI/CD workflows and scripts", "weight": 6,
      "paths": [".github/workflows/**", ".github/scripts/**", ".github/review-risk.json"] },
    { "id": "instructions", "label": "agent instructions", "weight": 3,
      "paths": ["CLAUDE.md", ".agents/**"] },
    { "id": "build", "label": "build config / dependencies", "weight": 4,
      "paths": ["package.json", "package-lock.json", "vite.config.ts", "vitest.config.ts", "tsconfig*.json"] },
    { "id": "backend", "label": "Supabase / auth", "weight": 5,
      "paths": ["supabase/**", "src/lib/supabase*.ts", "src/types/database.types.ts"] },
    { "id": "spend", "label": "scripts that spend money", "weight": 5,
      "paths": ["scripts/pixellab-*", "scripts/ai-*", "src/artificer-ai/players/**"] }
  ],
  "size": [ { "lines": 400, "weight": 1 }, { "lines": 1000, "weight": 2 } ],
  "untested": { "label": "no test changes", "weight": 2,
    "codePaths": ["src/**/*.ts", "storytelling/**/*.ts", "mapgen/**/*.ts", "worldmap/**/*.ts", "scripts/**"],
    "testPaths": ["**/*.test.ts", "tests/**"] },
  "lowRisk": { "label": "docs, styles or assets only",
    "paths": ["**/*.md", "wiki/**", "dev/**", "**/*.css", "public/**", "screenshots/**"] },
  "defaultLens": "general"
}
