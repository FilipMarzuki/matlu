# Supabase — reuse the same vars already set in Vercel for the main game
# Get from: Supabase dashboard → Settings → API
VITE_SUPABASE_URL=https://<project>.supabase.co
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=sb_publishable_...

# Notion — used for lore sync, blog drafts (server-side only)
NOTION_API_KEY=secret_...

# GitHub read token — fine-grained PAT, issues:read on FilipMarzuki/matlu.
# Used by github-issues.ts at build time to fetch the issue list.
# Set in Vercel project env vars (Settings → Environment Variables → GITHUB_TOKEN).
GITHUB_TOKEN=github_pat_...

# Cross-site link — Matlu Codex wiki
PUBLIC_WIKI_URL=https://matlu-codex.vercel.app

# Core Warden game URL — used by the /audio editor's preview button to fetch
# the currently-live audio file for a sound slot
PUBLIC_GAME_URL=https://corewarden.app

# Audio editor (#944) — /audio page, password-gated sound swap tool
# Shared password for the sound designer. Min 16 characters recommended.
AUDIO_EDITOR_PASSWORD=change-me-before-deploy
# GitHub PAT with contents:write on FilipMarzuki/matlu — commits uploaded
# audio files + manifest updates to AUDIO_GITHUB_BRANCH.
AUDIO_GITHUB_TOKEN=github_pat_...
AUDIO_GITHUB_REPO=FilipMarzuki/matlu
AUDIO_GITHUB_BRANCH=sound-updates
