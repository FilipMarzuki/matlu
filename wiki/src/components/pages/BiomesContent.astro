---
import Base from '../../layouts/Base.astro';
import { BIOMES } from '../../data/biomes';
import { t } from '../../i18n/index';
import type { Lang } from '../../i18n/index';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const gameUrl = import.meta.env.PUBLIC_GAME_URL ?? 'https://corewarden.app';
const worldForgeUrl = `${gameUrl}/biome`;

function slugify(name: string): string {
  return name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
}

function hexColor(c: number): string {
  return '#' + c.toString(16).padStart(6, '0');
}

function pct(v: number): string {
  return `${Math.round(Math.min(1, Math.max(0, v)) * 100)}%`;
}

const biomes = BIOMES.map((b) => ({
  ...b,
  slug: slugify(b.name),
  css: hexColor(b.overlayColor),
}));

// These are baked in at Vercel build time — safe to expose (publishable key).
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL ?? '';
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY ?? '';
---

<Base
  title={t(lang, 'Biomes', 'Biomer')}
  description={t(lang, 'Every biome in the Matlu multiworld — from Sea to Snow Field.', 'Varje biom i Matlu-multiversum — från hav till snöfält.')}
  lang={lang}
>
  <h1>{t(lang, 'Biomes', 'Biomer')}</h1>
  <p class="subtitle">
    {t(lang, 'The twelve terrain types of Mistheim, from sea level to permanent snowfield.', 'De tolv terrängtyper i Mistheim, från havsnivå till permanent snöfält.')}
  </p>

  <div class="world-forge-card">
    <div class="world-forge-info">
      <h2>World Forge</h2>
      <p>
        {t(
          lang,
          'Explore every biome in Core Warden — inspect tile palettes, decoration scatter, and biome boundaries in real time. Works in your browser.',
          'Utforska varje biom i Core Warden — inspektera kakelmönster, dekorationer och biomgränser i realtid. Fungerar i din webbläsare.',
        )}
      </p>
    </div>
    <a href={worldForgeUrl} class="world-forge-btn" target="_blank" rel="noopener">
      {t(lang, 'Open World Forge →', 'Öppna World Forge →')}
    </a>
  </div>

  <div id="supa-cfg" data-url={supabaseUrl} data-key={supabaseKey} hidden></div>

  <div class="grid">
    {biomes.map((b) => (
      <article id={b.slug} class="card">
        <div class="swatch" style={`background: ${b.css};`}>
          <img
            src={`/assets/screenshots/biomes/${b.slug}.png`}
            alt={`${b.name} screenshot`}
            class="screenshot"
            onerror="this.style.display='none'"
            loading="lazy"
          />
        </div>

        <div class="body">
          <h2>
            <span class="name">{b.name}</span>
            <a href={`#${b.slug}`} class="anchor" aria-label={`Link to ${b.name}`}>#</a>
          </h2>

          <div class="stats">
            <div class="stat">
              <span class="stat-label">{t(lang, 'Elev', 'Höjd')}</span>
              <div class="bar-track">
                <div class="bar-fill" style={`width: ${pct(b.elev)};`} />
              </div>
              <span class="stat-val">{Math.round(b.elev * 100)}</span>
            </div>
            <div class="stat">
              <span class="stat-label">{t(lang, 'Temp', 'Temp')}</span>
              <div class="bar-track">
                <div class="bar-fill bar-temp" style={`width: ${pct(b.temp)};`} />
              </div>
              <span class="stat-val">{Math.round(b.temp * 100)}</span>
            </div>
            <div class="stat">
              <span class="stat-label">{t(lang, 'Moist', 'Fukt')}</span>
              <div class="bar-track">
                <div class="bar-fill bar-moist" style={`width: ${pct(b.moist)};`} />
              </div>
              <span class="stat-val">{Math.round(b.moist * 100)}</span>
            </div>
          </div>

          <p class="desc">{b.description}</p>

          <details class="comments" data-slug={b.slug}>
            <summary>{t(lang, 'Comments', 'Kommentarer')}</summary>

            <ul class="comments-list" data-role="list">
              <li class="comments-status" data-role="status">{t(lang, 'Loading…', 'Laddar…')}</li>
            </ul>

            <form class="comments-form" data-role="form" novalidate>
              <input
                type="text"
                name="author"
                placeholder={t(lang, 'Name (optional)', 'Namn (valfritt)')}
                maxlength="60"
              />
              <textarea
                name="body"
                rows={2}
                placeholder={t(lang, 'Leave a comment…', 'Lämna en kommentar…')}
                required
              />
              <button type="submit">{t(lang, 'Submit', 'Skicka')}</button>
            </form>
          </details>
        </div>
      </article>
    ))}
  </div>
</Base>

<script>
  import { createClient } from '@supabase/supabase-js';

  const cfg = document.getElementById('supa-cfg') as HTMLElement;
  const url = cfg.dataset.url ?? '';
  const key = cfg.dataset.key ?? '';

  // Untyped client — wiki doesn't import the game's database.types.ts
  const supabase = createClient(url, key);

  interface BiomeCommentRow {
    author: string | null;
    body: string;
    created_at: string | null;
  }

  function relativeTime(iso: string | null): string {
    if (!iso) return '';
    const seconds = Math.max(0, (Date.now() - new Date(iso).getTime()) / 1000);
    const units: [string, number][] = [
      ['year', 31536000],
      ['month', 2592000],
      ['day', 86400],
      ['hour', 3600],
      ['minute', 60],
    ];
    for (const [label, secs] of units) {
      const value = Math.floor(seconds / secs);
      if (value >= 1) return `${value} ${label}${value > 1 ? 's' : ''} ago`;
    }
    return 'just now';
  }

  function renderComments(listEl: HTMLElement, comments: BiomeCommentRow[]): void {
    listEl.innerHTML = '';
    if (comments.length === 0) {
      const empty = document.createElement('li');
      empty.className = 'comments-status';
      empty.textContent = 'No comments yet.';
      listEl.appendChild(empty);
      return;
    }
    for (const c of comments) {
      const item = document.createElement('li');
      item.className = 'comment';
      const meta = document.createElement('div');
      meta.className = 'comment-meta';
      meta.textContent = `${c.author?.trim() || 'Anonymous'} · ${relativeTime(c.created_at)}`;
      const body = document.createElement('p');
      body.className = 'comment-body';
      body.textContent = c.body;
      item.appendChild(meta);
      item.appendChild(body);
      listEl.appendChild(item);
    }
  }

  async function loadComments(slug: string, listEl: HTMLElement): Promise<void> {
    const { data, error } = await supabase
      .from('biome_comments')
      .select('author, body, created_at')
      .eq('biome_slug', slug)
      .order('created_at', { ascending: false })
      .limit(10);

    if (error) {
      console.error('Load comments error:', error);
      listEl.innerHTML = '';
      const status = document.createElement('li');
      status.className = 'comments-status';
      status.textContent = 'Could not load comments.';
      listEl.appendChild(status);
      return;
    }

    renderComments(listEl, (data ?? []) as BiomeCommentRow[]);
  }

  document.querySelectorAll<HTMLDetailsElement>('details.comments').forEach((details) => {
    const slug = details.dataset.slug ?? '';
    const listEl = details.querySelector<HTMLElement>('[data-role="list"]');
    const form = details.querySelector<HTMLFormElement>('[data-role="form"]');
    if (!listEl || !form) return;

    let loaded = false;
    details.addEventListener('toggle', () => {
      if (details.open && !loaded) {
        loaded = true;
        loadComments(slug, listEl);
      }
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const author = ((data.get('author') as string | null) ?? '').trim();
      const body = ((data.get('body') as string | null) ?? '').trim();
      if (!body) return;

      const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (submitBtn) submitBtn.disabled = true;

      const { error } = await supabase.from('biome_comments').insert({
        biome_slug: slug,
        author: author || null,
        body,
      });

      if (submitBtn) submitBtn.disabled = false;

      if (error) {
        console.error('Submit comment error:', error);
        return;
      }

      form.reset();
      loaded = true;
      await loadComments(slug, listEl);
    });
  });
</script>

<style>
  h1 { margin-bottom: 0.4rem; }

  .subtitle {
    font-family: 'Outfit', sans-serif;
    font-size: 0.95rem;
    color: var(--text-dim);
    margin-bottom: 1.5rem;
  }

  .world-forge-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent-hi);
    border-radius: 6px;
    padding: 1.25rem 1.5rem;
    margin-bottom: 2rem;
    background: rgba(95, 168, 95, 0.04);
    flex-wrap: wrap;
  }

  .world-forge-info h2 {
    font-family: 'Pixelify Sans', monospace;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--accent-hi);
    margin: 0 0 0.3rem 0;
  }

  .world-forge-info p {
    font-family: 'Outfit', sans-serif;
    font-size: 0.87rem;
    color: var(--text-dim);
    margin: 0;
    max-width: 460px;
  }

  .world-forge-btn {
    display: inline-block;
    white-space: nowrap;
    background: var(--gold);
    color: #1a1200;
    font-family: 'Pixelify Sans', monospace;
    font-size: 0.85rem;
    font-weight: 700;
    padding: 0.6rem 1.25rem;
    border-radius: 0;
    text-decoration: none;
    box-shadow: 3px 3px 0 var(--gold-dim);
    transition: box-shadow 0.08s, transform 0.08s;
  }

  .world-forge-btn:hover {
    text-decoration: none;
    box-shadow: 4px 4px 0 var(--gold-dim);
  }
  .world-forge-btn:active {
    box-shadow: 1px 1px 0 var(--gold-dim);
    transform: translate(2px, 2px);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
    transition: border-color 0.15s, box-shadow 0.15s;
  }

  .card:target {
    border-color: var(--accent);
    box-shadow: 0 0 0 2px rgba(95, 168, 95, 0.25);
  }

  .swatch {
    height: 100px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .screenshot {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .body { padding: 1rem; }

  h2 {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 0.75rem;
    font-size: 1rem;
  }

  .name {
    font-family: 'Pixelify Sans', monospace;
    font-weight: 700;
    color: var(--text);
  }

  .anchor {
    font-size: 0.75rem;
    color: var(--text-dim);
    opacity: 0;
    transition: opacity 0.15s;
    text-decoration: none;
  }

  .card:hover .anchor { opacity: 1; }

  .stats {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    margin-bottom: 0.85rem;
  }

  .stat {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .stat-label {
    font-family: 'Outfit', sans-serif;
    font-size: 0.72rem;
    color: var(--text-dim);
    width: 32px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .bar-track {
    flex: 1;
    height: 5px;
    background: var(--surface-hi);
    border-radius: 3px;
    overflow: hidden;
  }

  .bar-fill {
    height: 100%;
    background: var(--accent);
    border-radius: 3px;
    transition: width 0.3s;
  }

  .bar-temp  { background: var(--amber); }
  .bar-moist { background: #4ab0d0; }

  .stat-val {
    font-family: 'Outfit', sans-serif;
    font-size: 0.72rem;
    color: var(--text-dim);
    width: 24px;
    text-align: right;
  }

  .desc {
    font-family: 'Outfit', sans-serif;
    font-size: 0.875rem;
    color: var(--text-dim);
    line-height: 1.6;
    margin: 0;
  }

  .comments {
    margin-top: 0.85rem;
    border-top: 1px solid var(--border);
    padding-top: 0.6rem;
  }

  .comments summary {
    cursor: pointer;
    font-family: 'Outfit', sans-serif;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-dim);
    user-select: none;
  }

  .comments summary:hover { color: var(--accent-hi); }

  .comments-list {
    list-style: none;
    margin: 0.6rem 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-height: 220px;
    overflow-y: auto;
  }

  .comments-status {
    font-family: 'Outfit', sans-serif;
    font-size: 0.8rem;
    color: var(--text-dim);
  }

  .comment {
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.5rem 0.65rem;
  }

  .comment-meta {
    font-family: 'Outfit', sans-serif;
    font-size: 0.72rem;
    color: var(--text-dim);
    margin-bottom: 0.2rem;
  }

  .comment-body {
    font-family: 'Outfit', sans-serif;
    font-size: 0.85rem;
    color: var(--text);
    margin: 0;
    white-space: pre-wrap;
    word-break: break-word;
  }

  .comments-form {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .comments-form input,
  .comments-form textarea {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--text);
    font-family: 'Outfit', sans-serif;
    font-size: 0.85rem;
    padding: 0.45rem 0.6rem;
    resize: vertical;
    transition: border-color 0.15s;
  }

  .comments-form input:focus,
  .comments-form textarea:focus {
    outline: none;
    border-color: var(--accent);
  }

  .comments-form button {
    align-self: flex-start;
    background: var(--accent);
    border: none;
    border-radius: 6px;
    color: #fff;
    cursor: pointer;
    font-family: 'Pixelify Sans', monospace;
    font-size: 0.82rem;
    font-weight: 700;
    padding: 0.4rem 1.1rem;
    transition: background 0.15s;
  }

  .comments-form button:hover { background: var(--accent-hi); }
  .comments-form button:disabled { opacity: 0.55; cursor: not-allowed; }
</style>
