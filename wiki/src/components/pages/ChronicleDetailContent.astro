---
import Base from '../../layouts/Base.astro';
import type { Chronicle } from '../../lib/chronicles';
import { t } from '../../i18n/index';
import type { Lang } from '../../i18n/index';

interface Props {
  lang: Lang;
  chronicle: Chronicle;
}

const { lang, chronicle: c } = Astro.props;

const label = lang === 'sv' ? c.meta.labelSv : c.meta.label;
const subtitle = lang === 'sv' ? c.meta.subtitleSv : c.meta.subtitle;

const KIND_LABEL: Record<string, [string, string]> = {
  succession: ['succession', 'tronföljd'],
  war:        ['war', 'krig'],
  house:      ['house', 'ätt'],
  calamity:   ['calamity', 'olycka'],
  religion:   ['religion', 'religion'],
  founding:   ['founding', 'grundande'],
  scheme:     ['scheme', 'ränksmide'],
  challenger: ['challenger', 'utmanare'],
  culture:    ['culture', 'kultur'],
  ancient:    ['ancient', 'urgammalt'],
};
function kindLabel(k: string): string {
  const pair = KIND_LABEL[k];
  return pair ? t(lang, pair[0], pair[1]) : k;
}

const KIND_COLOR: Record<string, string> = {
  succession: '#c9a45e',
  war:        '#d16565',
  house:      '#8a6ec7',
  calamity:   '#7d5b3d',
  religion:   '#7fa9d1',
  founding:   '#5fa85f',
  scheme:     '#a35fa8',
  challenger: '#c9a45e',
  culture:    '#5fa5a8',
  ancient:    '#8a8a8a',
};
function kindColor(k: string): string {
  return KIND_COLOR[k] ?? '#8a8a8a';
}

const CLIMATE_LABEL: Record<string, [string, string]> = {
  cold:    ['a cold age',      'en kall tidsålder'],
  warm:    ['a warm age',      'en varm tidsålder'],
  neutral: ['a temperate age', 'en tempererad tidsålder'],
};
const climatePair = CLIMATE_LABEL[c.climate.phase] ?? ['a temperate age', 'en tempererad tidsålder'];
const climatePhrase = t(lang, climatePair[0], climatePair[1]);

// --- Timeline maths -------------------------------------------------------
// Map each arc to a horizontal bar over the chronicle's year range. Timeline
// is only rendered when we have >= 2 arcs (otherwise it's noise).
const timelineFrom = Math.min(c.meta.startYear, ...c.arcs.map((a) => a.startYear));
const timelineTo   = Math.max(c.meta.endYear, ...c.arcs.map((a) => a.endYear));
const timelineSpan = Math.max(1, timelineTo - timelineFrom);
function bar(a: (typeof c.arcs)[number]): { leftPct: number; widthPct: number } {
  const leftPct  = ((a.startYear - timelineFrom) / timelineSpan) * 100;
  const widthPct = Math.max(0.8, ((a.endYear - a.startYear) / timelineSpan) * 100);
  return { leftPct, widthPct };
}
const yearTicks: number[] = [];
{
  const step = Math.max(50, Math.round(timelineSpan / 8 / 25) * 25);
  for (let y = Math.ceil(timelineFrom / step) * step; y <= timelineTo; y += step) yearTicks.push(y);
}

const backHref = lang === 'sv' ? '/sv/chronicles' : '/chronicles';
---

<Base
  title={label}
  description={subtitle}
  lang={lang}
>
  <div class="breadcrumb">
    <a href={backHref}>← {t(lang, 'All chronicles', 'Alla krönikor')}</a>
  </div>

  <h1>{label}</h1>
  <p class="header-line">
    {t(lang, 'World', 'Värld')}: <strong>{c.meta.world}</strong>
    · {t(lang, 'seed', 'frö')} <strong>{c.meta.seed}</strong>
    · {c.meta.startYear}–{c.meta.endYear}
    · {c.meta.chronicledEvents} {t(lang, 'events chronicled', 'krönta händelser')} / {c.meta.totalEvents} {t(lang, 'total', 'totalt')}
  </p>

  <section class="intro">
    <p>{subtitle}</p>
    <p>
      {t(lang,
        `The year is ${c.meta.endYear}. This world lives through ${climatePhrase} — the ${c.climate.phase} phase has held for ${c.meta.endYear - c.climate.phaseStartYear} years, its severity ${c.climate.severity}. ${c.kingdoms.length} kingdoms still hold their thrones, ${c.survivingHouses.length} houses still name their heirs.`,
        `Året är ${c.meta.endYear}. Denna värld lever genom ${climatePhrase} — ${c.climate.phase}-fasen har hållit i ${c.meta.endYear - c.climate.phaseStartYear} år, med allvar ${c.climate.severity}. ${c.kingdoms.length} kungariken sitter fortfarande vid sina troner, ${c.survivingHouses.length} ätter namnger fortfarande sina arvingar.`,
      )}
    </p>
  </section>

  {c.arcs.length >= 2 && (
    <section>
      <h2>{t(lang, 'Arc timeline', 'Bågtidslinje')}</h2>
      <p class="section-lead">
        {t(lang,
          'The biggest story-threads plotted against the years. Colour by kind; length shows how long each arc ran.',
          'De största berättelsetrådarna över åren. Färg per typ; längd visar hur länge varje båge pågick.',
        )}
      </p>
      <div class="timeline">
        <div class="year-axis">
          {yearTicks.map((y) => (
            <span class="tick" style={`left:${((y - timelineFrom) / timelineSpan) * 100}%`}>{y}</span>
          ))}
        </div>
        {c.arcs.slice(0, 16).map((a) => {
          const b = bar(a);
          return (
            <div class="row">
              <span class="row-label">{a.title}</span>
              <div class="track">
                <div
                  class="bar"
                  style={`left:${b.leftPct}%;width:${b.widthPct}%;background:${kindColor(a.kind)}`}
                  title={`${a.title} (${a.startYear}-${a.endYear})`}
                ></div>
              </div>
            </div>
          );
        })}
      </div>
    </section>
  )}

  <section class="grid">
    <div class="col">
      <h2>{t(lang, 'Kingdoms of the age', 'Rikena i tiden')}</h2>
      <ul class="plain">
        {c.kingdoms.map((k) => (
          <li>
            <strong>{k.name}</strong> <span class="dim">— {k.seat}</span>
            {k.holder ? <><br /><span class="dim">{t(lang, 'held by', 'innehas av')} {k.holder}</span></> : <><br /><span class="dim">{t(lang, 'vacant, contested', 'obesatt, omstridd')}</span></>}
          </li>
        ))}
      </ul>
    </div>

    <div class="col">
      <h2>{t(lang, 'Surviving houses', 'Kvarlevande ätter')}</h2>
      <ul class="plain">
        {c.survivingHouses.map((h) => (
          <li>
            <strong>{h.name}</strong>
            <span class="dim">— {t(lang, 'founded', 'grundad')} {h.foundedYear} · {h.members} {t(lang, 'living members', 'levande medlemmar')}</span>
            {h.specialization && (
              <><br /><span class="dim">{t(lang, 'specializes in', 'specialiserad i')} {h.specialization} ({Math.round(h.specializationDepth * 100)}%)</span></>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section>
    <h2>{t(lang, 'Story arcs', 'Berättelsebågar')}</h2>
    <p class="section-lead">
      {t(lang, 'Threads sorted biggest first. Click a heading to expand year-by-year events.',
              'Trådar sorterade störst först. Klicka på en rubrik för att se händelserna år för år.')}
    </p>
    {c.arcs.map((arc) => (
      <details class="arc">
        <summary>
          <span class="arc-title">{arc.title}</span>
          <span class="arc-meta">
            <span class="kind" style={`color:${kindColor(arc.kind)}`}>{kindLabel(arc.kind)}</span>
            · {arc.startYear}–{arc.endYear}
            · {arc.eventCount} {t(lang, 'events', 'händelser')}
            · {t(lang, 'weight', 'vikt')} {arc.significance}
          </span>
        </summary>
        <ol class="events">
          {arc.events.map((ev) => (
            <li>
              <span class="year">{ev.year}</span>
              <span class="text">{ev.text}</span>
            </li>
          ))}
        </ol>
      </details>
    ))}
  </section>

  {c.livingDeities.length > 0 && (
    <section>
      <h2>{t(lang, 'Powers of the age', 'Krafter i tiden')}</h2>
      <ul class="plain">
        {c.livingDeities.map((d) => (
          <li>
            <strong>{d.name}</strong> <span class="dim">— {d.tier === 'demigod' ? t(lang, 'demigod', 'halvgud') : t(lang, 'god', 'gud')}, {t(lang, 'patron of', 'beskyddare av')} {d.domain}</span>
            <br /><span class="dim">{t(lang, 'mood', 'sinnesstämning')} {d.mood} · {t(lang, 'power', 'kraft')} {d.power} ({t(lang, 'peaked at', 'toppade vid')} {d.peakPower})</span>
          </li>
        ))}
      </ul>
    </section>
  )}

  {c.livingLanguages.length > 0 && (
    <section>
      <h2>{t(lang, 'Living tongues', 'Levande tungomål')}</h2>
      <ul class="plain">
        {c.livingLanguages.map((lg) => (
          <li>
            <strong>{lg.name}</strong>
            <span class="dim">
              — {lg.speakerCultures} {t(lang, 'speaker cultures', 'talande kulturer')}
              · {t(lang, 'drift', 'drift')} {lg.driftScore}
              · {t(lang, 'corpus', 'korpus')} {lg.writtenCorpus}
              {lg.linguaFrancaRoutes > 0 && <> · {t(lang, 'lingua franca on', 'lingua franca på')} {lg.linguaFrancaRoutes} {t(lang, 'routes', 'vägar')}</>}
            </span>
          </li>
        ))}
      </ul>
    </section>
  )}

  {c.notableDiseases.length > 0 && (
    <section>
      <h2>{t(lang, 'Named plagues', 'Namngivna farsoter')}</h2>
      <ul class="plain">
        {c.notableDiseases.map((d) => (
          <li>
            <strong>{d.name}</strong> <span class="dim">— {d.category === 'magical' ? t(lang, 'magical', 'magisk') : t(lang, 'mundane', 'jordnära')} {d.family}</span>
            <br /><span class="dim">
              {t(lang, 'emerged', 'framträdde')} {d.emergedYear}
              {d.burnedOutYear !== null && <> · {t(lang, 'burned out', 'brann ut')} {d.burnedOutYear}</>}
              · {d.strikeCount} {t(lang, 'strikes', 'anfall')}
              · {d.totalDeaths.toLocaleString('en')} {t(lang, 'dead', 'döda')}
            </span>
          </li>
        ))}
      </ul>
    </section>
  )}

  {c.academies.length > 0 && (
    <section>
      <h2>{t(lang, 'Academies still standing', 'Kvarstående akademier')}</h2>
      <ul class="plain">
        {c.academies.map((a) => (
          <li>
            <strong>{a.name}</strong> <span class="dim">— {a.province}, {t(lang, 'founded', 'grundad')} {a.foundedYear}</span>
            <br /><span class="dim">{t(lang, 'prestige', 'anseende')} {a.prestige} ({t(lang, 'peaked at', 'toppade vid')} {a.peakPrestige}) · {a.scholars} {t(lang, 'scholars', 'lärda')}</span>
          </li>
        ))}
      </ul>
    </section>
  )}

  {c.tradeRoutes.length > 0 && (
    <section>
      <h2>{t(lang, 'Trade routes of the age', 'Handelsvägar i tiden')}</h2>
      <ul class="plain">
        {c.tradeRoutes.map((r) => (
          <li>
            <strong>{r.from} ↔ {r.to}</strong> <span class="dim">— {r.conduit}, {t(lang, 'founded', 'grundad')} {r.foundedYear}</span>
            <br /><span class="dim">{t(lang, 'wealth', 'rikedom')} {r.wealth} ({t(lang, 'peaked at', 'toppade vid')} {r.peakWealth})</span>
          </li>
        ))}
      </ul>
    </section>
  )}

  {c.guilds.length > 0 && (
    <section>
      <h2>{t(lang, 'Guilds & confraternities', 'Gillen & broderskap')}</h2>
      <ul class="plain">
        {c.guilds.map((g) => (
          <li>
            <strong>{g.name}</strong> <span class="dim">— {g.craft}, {t(lang, 'founded', 'grundad')} {g.foundedYear} · {g.members} {t(lang, 'members', 'medlemmar')}</span>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="footer-meta">
    <p class="dim small">
      {t(lang, 'Generated', 'Genererad')} {new Date(c.meta.generatedAt).toISOString().slice(0, 10)}
      · {t(lang, 'engine seed', 'motorfrö')} {c.meta.seed}
      · {c.meta.years} {t(lang, 'years simulated', 'år simulerade')}
      {c.meta.prehistorySpan > 0 && <> · {c.meta.prehistorySpan} {t(lang, 'years of prehistory', 'års förhistoria')}</>}
    </p>
  </section>
</Base>

<style>
  h1 { margin-bottom: 0.4rem; }

  .breadcrumb {
    margin-bottom: 1rem;
    font-size: 0.9rem;
  }

  .breadcrumb a {
    color: var(--text-dim);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--accent);
  }

  .header-line {
    color: var(--text-dim);
    font-size: 0.9rem;
    margin-bottom: 1.5rem;
  }

  .intro {
    background: var(--surface);
    border-left: 3px solid var(--accent);
    padding: 1rem 1.25rem;
    margin-bottom: 2.5rem;
    border-radius: 0 6px 6px 0;
  }

  .intro p {
    margin: 0 0 0.5rem 0;
    line-height: 1.7;
  }

  .intro p:last-child { margin-bottom: 0; }

  section {
    margin-bottom: 2.5rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
  }

  h2 {
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-dim);
    margin-bottom: 1rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--border);
  }

  .section-lead {
    color: var(--text-dim);
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
  }

  .plain {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .plain li {
    line-height: 1.5;
  }

  .dim {
    color: var(--text-dim);
    font-size: 0.9rem;
  }

  .small {
    font-size: 0.8rem;
  }

  /* --- Arc timeline ------------------------------------------------------ */
  .timeline {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.6rem 0.75rem 1rem;
    overflow-x: auto;
    min-width: 100%;
  }

  .year-axis {
    position: relative;
    height: 1.5rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 0.75rem;
    margin-left: 14rem;
  }

  .year-axis .tick {
    position: absolute;
    transform: translateX(-50%);
    font-size: 0.7rem;
    color: var(--text-dim);
    top: 0.15rem;
    font-family: 'Pixelify Sans', monospace;
  }

  .row {
    display: grid;
    grid-template-columns: 14rem 1fr;
    align-items: center;
    gap: 0.5rem;
    height: 1.4rem;
    margin-bottom: 0.3rem;
  }

  .row-label {
    font-size: 0.78rem;
    color: var(--text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    padding-right: 0.5rem;
  }

  .track {
    position: relative;
    height: 100%;
    background: rgba(255, 255, 255, 0.03);
    border-radius: 2px;
  }

  .bar {
    position: absolute;
    top: 0.15rem;
    bottom: 0.15rem;
    border-radius: 2px;
    opacity: 0.75;
  }

  /* --- Arc details ------------------------------------------------------ */
  .arc {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    margin-bottom: 0.6rem;
    padding: 0.8rem 1rem;
  }

  .arc[open] {
    border-color: var(--accent);
  }

  .arc summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .arc summary::-webkit-details-marker { display: none; }
  .arc summary::marker { content: ''; }

  .arc-title {
    color: var(--gold);
    font-family: 'Pixelify Sans', monospace;
    font-weight: 700;
    font-size: 1rem;
  }

  .arc-meta {
    color: var(--text-dim);
    font-size: 0.8rem;
  }

  .kind {
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 600;
  }

  .events {
    margin: 1rem 0 0 0;
    padding-left: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    border-top: 1px dashed var(--border);
    padding-top: 1rem;
  }

  .events li {
    display: grid;
    grid-template-columns: 4rem 1fr;
    gap: 0.75rem;
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .events .year {
    color: var(--text-dim);
    font-family: 'Pixelify Sans', monospace;
    font-weight: 600;
    text-align: right;
  }

  .events .text {
    color: var(--text);
  }

  .footer-meta {
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }
</style>
