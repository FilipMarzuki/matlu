---
import Base from '../../layouts/Base.astro';
import canonRaw from '../../data/story-canon.json';
import { t } from '../../i18n/index';
import type { Lang } from '../../i18n/index';

interface Props {
  lang: Lang;
}

// Explicit shape for the canon JSON — Astro/TS can't infer non-`never` types
// from empty arrays in a static JSON import, so we widen the type ourselves.
interface CanonKingdom { name: string; seat: string; holder: string | null }
interface CanonHouse {
  name: string;
  foundedYear: number;
  members: number;
  specialization: string | null;
  specializationDepth: number;
}
interface CanonArcEvent { year: number; type: string; text: string }
interface CanonArc {
  id: string;
  title: string;
  kind: string;
  startYear: number;
  endYear: number;
  eventCount: number;
  significance: number;
  events: CanonArcEvent[];
}
interface CanonTradeRoute {
  from: string;
  to: string;
  conduit: string;
  foundedYear: number;
  wealth: number;
  peakWealth: number;
}
interface CanonAcademy {
  name: string;
  province: string;
  foundedYear: number;
  prestige: number;
  peakPrestige: number;
  scholars: number;
}
interface CanonGuild {
  name: string;
  craft: string;
  foundedYear: number;
  members: number;
}
interface Canon {
  meta: {
    generatedAt: string;
    seed: number;
    world: string;
    years: number;
    prehistorySpan: number;
    magic: boolean;
    catastrophes: boolean;
    threshold: number;
    startYear: number;
    endYear: number;
    totalEvents: number;
    chronicledEvents: number;
  };
  climate: { phase: string; severity: number; phaseStartYear: number; phaseDurationYears: number };
  kingdoms: CanonKingdom[];
  survivingHouses: CanonHouse[];
  arcs: CanonArc[];
  tradeRoutes: CanonTradeRoute[];
  academies: CanonAcademy[];
  guilds: CanonGuild[];
  eventTally: { type: string; count: number }[];
}

const { lang } = Astro.props;
const c = canonRaw as unknown as Canon;

// Kind → localized label. Keeps arc chips readable.
const KIND_LABEL: Record<string, [string, string]> = {
  succession:   ['succession',   'tronföljd'],
  war:          ['war',          'krig'],
  house:        ['house',        'ätt'],
  calamity:     ['calamity',     'olycka'],
  religion:     ['religion',     'religion'],
  founding:     ['founding',     'grundande'],
  scheme:       ['scheme',       'ränksmide'],
  challenger:   ['challenger',   'utmanare'],
  culture:      ['culture',      'kultur'],
  ancient:      ['ancient',      'urgammalt'],
};
function kindLabel(k: string): string {
  const pair = KIND_LABEL[k];
  return pair ? t(lang, pair[0], pair[1]) : k;
}

// Climate phase → localized label.
const CLIMATE_LABEL: Record<string, [string, string]> = {
  cold:    ['a cold age',      'en kall tidsålder'],
  warm:    ['a warm age',      'en varm tidsålder'],
  neutral: ['a temperate age', 'en tempererad tidsålder'],
};
const climatePair = CLIMATE_LABEL[c.climate.phase] ?? ['a temperate age', 'en tempererad tidsålder'];
const climatePhrase = t(lang, climatePair[0], climatePair[1]);
---

<Base
  title={t(lang, 'The Frontier Chronicle', 'Frontier-krönikan')}
  description={t(lang, 'A procedural chronicle generated by the Matlu story engine — the frontier realms, seed 5.', 'En procedurell krönika genererad av Matlu-berättelsemotorn — gränslanden, frö 5.')}
  lang={lang}
>
  <div class="breadcrumb">
    <a href={lang === 'sv' ? '/sv/chronicles' : '/chronicles'}>← {t(lang, 'All chronicles', 'Alla krönikor')}</a>
  </div>

  <h1>{t(lang, 'The Frontier Chronicle', 'Frontier-krönikan')}</h1>
  <p class="header-line">
    {t(lang, 'World', 'Värld')}: <strong>{c.meta.world}</strong>
    · {t(lang, 'seed', 'frö')} <strong>{c.meta.seed}</strong>
    · {c.meta.startYear}–{c.meta.endYear}
    · {c.meta.chronicledEvents} {t(lang, 'events chronicled', 'krönta händelser')} / {c.meta.totalEvents} {t(lang, 'total', 'totalt')}
  </p>

  {/* Prose intro derived from the current world state — a scene-setting paragraph. */}
  <section class="intro">
    <p>
      {t(lang,
        `The year is ${c.meta.endYear}. The frontier realms are living through ${climatePhrase} — the ${c.climate.phase} phase has held for ${c.meta.endYear - c.climate.phaseStartYear} years, and its severity has climbed to ${c.climate.severity}. ${c.kingdoms.length} kingdoms still hold their thrones, ${c.survivingHouses.length} houses still name their heirs, and ${c.academies.length} academies still lecture beneath their vaulted halls.`,
        `Året är ${c.meta.endYear}. Gränslanden lever genom ${climatePhrase} — ${c.climate.phase}-fasen har hållit i ${c.meta.endYear - c.climate.phaseStartYear} år, och dess allvar har stigit till ${c.climate.severity}. ${c.kingdoms.length} kungariken sitter fortfarande vid sina troner, ${c.survivingHouses.length} ätter namnger fortfarande sina arvingar, och ${c.academies.length} akademier undervisar fortfarande under sina valv.`,
      )}
    </p>
  </section>

  <section class="grid">
    <div class="col">
      <h2>{t(lang, 'Kingdoms of the age', 'Rikena i tiden')}</h2>
      <ul class="plain">
        {c.kingdoms.map((k) => (
          <li>
            <strong>{k.name}</strong> <span class="dim">— {k.seat}</span>
            {k.holder ? <><br /><span class="dim">{t(lang, 'held by', 'innehas av')} {k.holder}</span></> : <><br /><span class="dim">{t(lang, 'vacant, contested', 'obesatt, omstridd')}</span></>}
          </li>
        ))}
      </ul>
    </div>

    <div class="col">
      <h2>{t(lang, 'Surviving houses', 'Kvarlevande ätter')}</h2>
      <ul class="plain">
        {c.survivingHouses.map((h) => (
          <li>
            <strong>{h.name}</strong>
            <span class="dim">— {t(lang, 'founded', 'grundad')} {h.foundedYear} · {h.members} {t(lang, 'living members', 'levande medlemmar')}</span>
            {h.specialization && (
              <><br /><span class="dim">{t(lang, 'specializes in', 'specialiserad i')} {h.specialization} ({Math.round(h.specializationDepth * 100)}%)</span></>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section>
    <h2>{t(lang, 'Story arcs', 'Berättelsebågar')}</h2>
    <p class="section-lead">
      {t(lang, 'The chronicle sorted into threads — the biggest stories first. Click a heading to expand year-by-year events.',
              'Krönikan sorterad i trådar — de största berättelserna först. Klicka på en rubrik för att se händelserna år för år.')}
    </p>
    {c.arcs.map((arc) => (
      <details class="arc">
        <summary>
          <span class="arc-title">{arc.title}</span>
          <span class="arc-meta">
            <span class="kind">{kindLabel(arc.kind)}</span>
            · {arc.startYear}–{arc.endYear}
            · {arc.eventCount} {t(lang, 'events', 'händelser')}
            · {t(lang, 'weight', 'vikt')} {arc.significance}
          </span>
        </summary>
        <ol class="events">
          {arc.events.map((ev) => (
            <li>
              <span class="year">{ev.year}</span>
              <span class="text">{ev.text}</span>
            </li>
          ))}
        </ol>
      </details>
    ))}
  </section>

  {c.academies.length > 0 && (
    <section>
      <h2>{t(lang, 'Academies still standing', 'Kvarstående akademier')}</h2>
      <ul class="plain">
        {c.academies.map((a) => (
          <li>
            <strong>{a.name}</strong> <span class="dim">— {a.province}, {t(lang, 'founded', 'grundad')} {a.foundedYear}</span>
            <br /><span class="dim">{t(lang, 'prestige', 'anseende')} {a.prestige} ({t(lang, 'peaked at', 'toppade vid')} {a.peakPrestige}) · {a.scholars} {t(lang, 'scholars', 'lärda')}</span>
          </li>
        ))}
      </ul>
    </section>
  )}

  {c.tradeRoutes.length > 0 && (
    <section>
      <h2>{t(lang, 'Trade routes of the frontier', 'Handelsvägar i gränslandet')}</h2>
      <ul class="plain">
        {c.tradeRoutes.map((r) => (
          <li>
            <strong>{r.from} ↔ {r.to}</strong> <span class="dim">— {r.conduit}, {t(lang, 'founded', 'grundad')} {r.foundedYear}</span>
            <br /><span class="dim">{t(lang, 'wealth', 'rikedom')} {r.wealth} ({t(lang, 'peaked at', 'toppade vid')} {r.peakWealth})</span>
          </li>
        ))}
      </ul>
    </section>
  )}

  {c.guilds.length > 0 && (
    <section>
      <h2>{t(lang, 'Guilds & confraternities', 'Gillen & broderskap')}</h2>
      <ul class="plain">
        {c.guilds.map((g) => (
          <li>
            <strong>{g.name}</strong> <span class="dim">— {g.craft}, {t(lang, 'founded', 'grundad')} {g.foundedYear} · {g.members} {t(lang, 'members', 'medlemmar')}</span>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="footer-meta">
    <p class="dim small">
      {t(lang, 'Generated', 'Genererad')} {new Date(c.meta.generatedAt).toISOString().slice(0, 10)}
      · {t(lang, 'engine seed', 'motorfrö')} {c.meta.seed}
      · {c.meta.years} {t(lang, 'years simulated', 'år simulerade')}
      · {c.meta.prehistorySpan} {t(lang, 'years of prehistory', 'års förhistoria')}
    </p>
  </section>
</Base>

<style>
  h1 {
    margin-bottom: 0.4rem;
  }

  .breadcrumb {
    margin-bottom: 1rem;
    font-size: 0.9rem;
  }

  .breadcrumb a {
    color: var(--text-dim);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--accent);
  }

  .header-line {
    color: var(--text-dim);
    font-size: 0.9rem;
    margin-bottom: 1.5rem;
  }

  .intro {
    background: var(--surface);
    border-left: 3px solid var(--accent);
    padding: 1rem 1.25rem;
    margin-bottom: 2.5rem;
    border-radius: 0 6px 6px 0;
  }

  .intro p {
    margin: 0;
    line-height: 1.7;
  }

  section {
    margin-bottom: 2.5rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
  }

  h2 {
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-dim);
    margin-bottom: 1rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--border);
  }

  .section-lead {
    color: var(--text-dim);
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
  }

  .plain {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .plain li {
    line-height: 1.5;
  }

  .dim {
    color: var(--text-dim);
    font-size: 0.9rem;
  }

  .small {
    font-size: 0.8rem;
  }

  .arc {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    margin-bottom: 0.6rem;
    padding: 0.8rem 1rem;
  }

  .arc[open] {
    border-color: var(--accent);
  }

  .arc summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .arc summary::-webkit-details-marker { display: none; }
  .arc summary::marker { content: ''; }

  .arc-title {
    color: var(--gold);
    font-family: 'Pixelify Sans', monospace;
    font-weight: 700;
    font-size: 1rem;
  }

  .arc-meta {
    color: var(--text-dim);
    font-size: 0.8rem;
  }

  .kind {
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 600;
    color: var(--accent);
  }

  .events {
    margin: 1rem 0 0 0;
    padding-left: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    border-top: 1px dashed var(--border);
    padding-top: 1rem;
  }

  .events li {
    display: grid;
    grid-template-columns: 4rem 1fr;
    gap: 0.75rem;
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .events .year {
    color: var(--text-dim);
    font-family: 'Pixelify Sans', monospace;
    font-weight: 600;
    text-align: right;
  }

  .events .text {
    color: var(--text);
  }

  .footer-meta {
    margin-top: 3rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }
</style>
