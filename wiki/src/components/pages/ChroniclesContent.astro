---
import Base from '../../layouts/Base.astro';
import canonRaw from '../../data/story-canon.json';
import { t } from '../../i18n/index';
import type { Lang } from '../../i18n/index';

interface Props {
  lang: Lang;
}

// Narrow shape — the index page only reads counts + metadata.
interface CanonForIndex {
  meta: { seed: number; startYear: number; endYear: number; chronicledEvents: number };
  arcs: unknown[];
  survivingHouses: unknown[];
  academies: unknown[];
  tradeRoutes: unknown[];
}
const canon = canonRaw as unknown as CanonForIndex;

const { lang } = Astro.props;
const slugBase = lang === 'sv' ? '/sv/chronicles' : '/chronicles';

// The canon JSON is the frozen output of one deterministic engine run. For now
// the wiki surfaces exactly one canonical chronicle — later, additional seeds
// (era-specific or realm-specific) can be listed alongside it.
const chronicles = [
  {
    slug: 'canon',
    title: t(lang, 'The Frontier Chronicle', 'Frontier-krönikan'),
    subtitle: `Seed ${canon.meta.seed} · ${canon.meta.startYear}–${canon.meta.endYear} · ${canon.meta.chronicledEvents} chronicled events`,
    summary: t(
      lang,
      "A procedural history of the frontier realms — kings and their heirs, sieges and famines, guilds risen and academies scattered. Generated by the Matlu story engine, one deterministic tick at a time.",
      "En procedurell historia över gränslanden — kungar och deras arvingar, belägringar och svält, gillen som rest sig och akademier som skingrats. Genererad av Matlu-berättelsemotorn, ett deterministiskt tick i taget.",
    ),
    arcs: canon.arcs.length,
    houses: canon.survivingHouses.length,
    academies: canon.academies.length,
    tradeRoutes: canon.tradeRoutes.length,
  },
];
---

<Base
  title={t(lang, 'Chronicles', 'Krönikor')}
  description={t(lang, 'Procedural chronicles of the Matlu multiworld — generated by the story engine.', 'Procedurella krönikor från Matlu-multiversum — genererade av berättelsemotorn.')}
  lang={lang}
>
  <h1>{t(lang, 'Chronicles', 'Krönikor')}</h1>
  <p class="subtitle">
    {t(lang,
      'Emergent histories, simulated year by year. Each chronicle is one deterministic run of the story engine — same seed, same story, every time.',
      'Framväxande historier, simulerade år för år. Varje krönika är en deterministisk körning av berättelsemotorn — samma frö, samma berättelse, varje gång.',
    )}
  </p>

  <div class="card-grid">
    {chronicles.map((c) => (
      <a href={`${slugBase}/${c.slug}`} class="card">
        <div class="card-top">
          <span class="badge">{t(lang, 'Canon', 'Kanon')}</span>
          <span class="stat">{c.subtitle}</span>
        </div>
        <h3>{c.title}</h3>
        <p class="summary">{c.summary}</p>
        <div class="chips">
          <span class="chip">{c.arcs} {t(lang, 'arcs', 'bågar')}</span>
          <span class="chip">{c.houses} {t(lang, 'houses', 'ätter')}</span>
          <span class="chip">{c.academies} {t(lang, 'academies', 'akademier')}</span>
          <span class="chip">{c.tradeRoutes} {t(lang, 'trade routes', 'handelsvägar')}</span>
        </div>
      </a>
    ))}
  </div>
</Base>

<style>
  h1 { margin-bottom: 0.4rem; }

  .subtitle {
    color: var(--text-dim);
    margin-bottom: 2rem;
    max-width: 720px;
    line-height: 1.6;
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1rem;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.4rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    text-decoration: none;
    color: var(--text);
    transition: border-color 0.15s, box-shadow 0.15s;
  }

  .card:hover {
    border-color: var(--accent);
    box-shadow: 0 0 12px rgba(95, 168, 95, 0.1);
    text-decoration: none;
  }

  .card-top {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .badge {
    font-family: 'Outfit', sans-serif;
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    background: var(--badge-bg);
    color: var(--badge-text);
    border-radius: 4px;
    padding: 0.15rem 0.5rem;
  }

  .stat {
    font-size: 0.75rem;
    color: var(--text-dim);
  }

  .card h3 {
    font-size: 1.2rem;
    color: var(--gold);
    font-family: 'Pixelify Sans', monospace;
    font-weight: 700;
    margin: 0;
  }

  .summary {
    font-size: 0.9rem;
    color: var(--text-dim);
    line-height: 1.55;
    margin: 0;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.3rem;
  }

  .chip {
    font-size: 0.72rem;
    color: var(--text-dim);
    border: 1px solid var(--border);
    border-radius: 3px;
    padding: 0.15rem 0.5rem;
  }
</style>
