---
import Base from '../../layouts/Base.astro';
import manifestRaw from '../../data/chronicles/index.json';
import { t } from '../../i18n/index';
import type { Lang } from '../../i18n/index';
import { loadChronicleMeta } from '../../lib/chronicles';

interface Props {
  lang: Lang;
}

interface ManifestEntry {
  slug: string;
  label: string;
  labelSv: string;
  subtitle: string;
  subtitleSv: string;
  seed: number;
  world: string;
  years: number;
  magic: boolean;
  catastrophes: boolean;
  prehistorySpan: number;
}
interface Manifest { chronicles: ManifestEntry[] }
const manifest = manifestRaw as unknown as Manifest;

const { lang } = Astro.props;
const slugBase = lang === 'sv' ? '/sv/chronicles' : '/chronicles';

// Enrich each manifest entry with per-chronicle counts pulled from its JSON.
const chronicles = manifest.chronicles.map((entry) => {
  const detail = loadChronicleMeta(entry.slug);
  return {
    ...entry,
    label: lang === 'sv' ? entry.labelSv : entry.label,
    subtitle: lang === 'sv' ? entry.subtitleSv : entry.subtitle,
    arcs: detail.arcs,
    houses: detail.houses,
    kingdoms: detail.kingdoms,
    tradeRoutes: detail.tradeRoutes,
    diseases: detail.diseases,
    deities: detail.deities,
    languages: detail.languages,
    startYear: detail.startYear,
    endYear: detail.endYear,
    chronicledEvents: detail.chronicledEvents,
  };
});

function flavourBadges(c: (typeof chronicles)[number]): string[] {
  const out: string[] = [];
  if (c.magic) out.push(t(lang, 'magic', 'magi'));
  if (c.catastrophes) out.push(t(lang, 'catastrophes', 'katastrofer'));
  if (c.prehistorySpan > 0) out.push(t(lang, 'prehistory', 'förhistoria'));
  return out;
}
---

<Base
  title={t(lang, 'Chronicles', 'Krönikor')}
  description={t(lang, 'Procedural chronicles of the Matlu multiworld — generated by the story engine.', 'Procedurella krönikor från Matlu-multiversum — genererade av berättelsemotorn.')}
  lang={lang}
>
  <h1>{t(lang, 'Chronicles', 'Krönikor')}</h1>
  <p class="subtitle">
    {t(lang,
      'Emergent histories, simulated year by year. Each chronicle is one deterministic run of the story engine — same seed, same config, same story, every time.',
      'Framväxande historier, simulerade år för år. Varje krönika är en deterministisk körning av berättelsemotorn — samma frö, samma konfiguration, samma berättelse, varje gång.',
    )}
  </p>

  <div class="card-grid">
    {chronicles.map((c) => (
      <a href={`${slugBase}/${c.slug}`} class="card">
        <div class="card-top">
          <span class="stat">{t(lang, 'Seed', 'Frö')} {c.seed} · {c.startYear}–{c.endYear} · {c.chronicledEvents} {t(lang, 'events', 'händelser')}</span>
        </div>
        <h3>{c.label}</h3>
        <p class="summary">{c.subtitle}</p>
        <div class="flavours">
          {flavourBadges(c).map((f) => <span class="flavour">{f}</span>)}
        </div>
        <div class="chips">
          <span class="chip">{c.arcs} {t(lang, 'arcs', 'bågar')}</span>
          <span class="chip">{c.kingdoms} {t(lang, 'kingdoms', 'kungariken')}</span>
          <span class="chip">{c.houses} {t(lang, 'houses', 'ätter')}</span>
          {c.tradeRoutes > 0 && <span class="chip">{c.tradeRoutes} {t(lang, 'trade routes', 'handelsvägar')}</span>}
          {c.diseases > 0 && <span class="chip">{c.diseases} {t(lang, 'plagues', 'farsoter')}</span>}
          {c.deities > 0 && <span class="chip">{c.deities} {t(lang, 'gods', 'gudar')}</span>}
          {c.languages > 0 && <span class="chip">{c.languages} {t(lang, 'tongues', 'tungomål')}</span>}
        </div>
      </a>
    ))}
  </div>
</Base>

<style>
  h1 { margin-bottom: 0.4rem; }

  .subtitle {
    color: var(--text-dim);
    margin-bottom: 2rem;
    max-width: 720px;
    line-height: 1.6;
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1rem;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.4rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    text-decoration: none;
    color: var(--text);
    transition: border-color 0.15s, box-shadow 0.15s;
  }

  .card:hover {
    border-color: var(--accent);
    box-shadow: 0 0 12px rgba(95, 168, 95, 0.1);
    text-decoration: none;
  }

  .card-top {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .stat {
    font-size: 0.75rem;
    color: var(--text-dim);
  }

  .card h3 {
    font-size: 1.2rem;
    color: var(--gold);
    font-family: 'Pixelify Sans', monospace;
    font-weight: 700;
    margin: 0;
  }

  .summary {
    font-size: 0.9rem;
    color: var(--text-dim);
    line-height: 1.55;
    margin: 0;
  }

  .flavours {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin-top: 0.2rem;
  }

  .flavour {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    background: rgba(95, 168, 95, 0.08);
    border: 1px solid rgba(95, 168, 95, 0.3);
    border-radius: 3px;
    padding: 0.1rem 0.45rem;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.3rem;
  }

  .chip {
    font-size: 0.72rem;
    color: var(--text-dim);
    border: 1px solid var(--border);
    border-radius: 3px;
    padding: 0.15rem 0.5rem;
  }
</style>
